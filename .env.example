# ─── Contracts (Foundry) ─────────────────────────────────────────────────────
# Deployer wallet private key. Use a hardware-backed ops wallet for mainnet.
DEPLOYER_PRIVATE_KEY=

# Arbitrum One RPC. The public endpoint works for low-volume ops; use Alchemy,
# Infura, or another paid RPC before opening public trading.
ARB_MAINNET_RPC=https://arb1.arbitrum.io/rpc
ARB_RPC_URL=https://arb1.arbitrum.io/rpc
ONCHAIN_RPC_URL=https://arb1.arbitrum.io/rpc

# Optional Arbitrum Sepolia RPC for MockMXNB rehearsals.
ARB_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc

# Optional: Arbiscan API key for contract verification.
ARBISCAN_API_KEY=

# ─── MXNB collateral ─────────────────────────────────────────────────────────
# MXNB on Arbitrum One, published by Juno/Bitso.
MXNB_ARBITRUM_ADDRESS=0xF197FFC28c23E0309B5559e7a166f2c6164C80aA
COLLATERAL_ADDRESS=0xF197FFC28c23E0309B5559e7a166f2c6164C80aA
ONCHAIN_COLLATERAL_ADDRESS=0xF197FFC28c23E0309B5559e7a166f2c6164C80aA

# ─── Protocol deployment (DeployProtocol*.s.sol) ─────────────────────────────
TREASURY_ADDRESS=
LIQUIDITY_RESERVE=
EMERGENCY_RESERVE=
FEE_COLLECTOR_ADDRESS=

# Mainnet should use Safes for ownership/resolution. Testnet can use EOAs.
ADMIN_SAFE_ADDRESS=
RESOLVER_SAFE_ADDRESS=
ADMIN_ADDRESS=
RESOLVER_ADDRESS=

# ─── Protocol runtime (Vercel serverless) ────────────────────────────────────
ONCHAIN_CHAIN_ID=42161
ONCHAIN_MARKET_FACTORY_ADDRESS=
ONCHAIN_MARKET_FACTORY_V2_ADDRESS=
ONCHAIN_DEPLOYER_SUBORG_ID=
ONCHAIN_DEPLOYER_ADDRESS=
ONCHAIN_RESOLVER_SUBORG_ID=
ONCHAIN_RESOLVER_ADDRESS=

# User delegation policies must include every deployed AMM pool that users can
# buy/sell/redeem. Update this list when new pools are created, then refresh
# user policies before public trading on those pools.
ONCHAIN_MARKET_POOL_ADDRESSES=

# Turnkey delegated signing.
TURNKEY_POLICIES_ENABLED=false
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_APP_NAME=Pronos
# TURNKEY_API_BASE_URL=https://api.turnkey.com

# Client-side Turnkey bundle (Vite).
VITE_TURNKEY_ORGANIZATION_ID=
# VITE_TURNKEY_API_BASE_URL=https://api.turnkey.com

# ─── MVP frontend contract config (Vite) ─────────────────────────────────────
VITE_ONCHAIN_CHAIN_ID=42161
VITE_PRONOS_ARBITRUM_FACTORY=
VITE_PRONOS_ARBITRUM_FACTORY_V2=
VITE_PRONOS_ARBITRUM_TOKEN=
VITE_PRONOS_ARBITRUM_TOKEN_V2=
VITE_PRONOS_ARBITRUM_ADMIN_SAFE=
VITE_PRONOS_ARBITRUM_RESOLVER_SAFE=

# ─── Protocol indexer ────────────────────────────────────────────────────────
DATABASE_URL=
DATABASE_READ_URL=
DATABASE_WRITE_URL=
MIGRATE_KEY=
CHAIN_ID=42161
PROTOCOL_CHAIN_ID=42161
FACTORY_ADDRESS=
FACTORY_V2_ADDRESS=
PRONOS_FACTORY_ADDRESS=
PRONOS_FACTORY_V2_ADDRESS=
INDEXER_START_BLOCK=
INDEXER_KEY=
CRON_SECRET=

# ─── Points app / sessions ──────────────────────────────────────────────────
# HMAC secret for signed session cookies. Must be at least 16 chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POINTS_SESSION_SECRET=

# Comma-separated admin usernames that can reach /admin in the points app.
POINTS_ADMIN_USERNAMES=
VITE_POINTS_ADMIN_USERNAMES=

# ─── Waitlist email (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=

# ─── Market-generation agents ────────────────────────────────────────────────
FOOTBALL_DATA_API_KEY=
FINNHUB_API_KEY=
CHAINLINK_RPC_URL=
BANXICO_API_TOKEN=
YOUTUBE_API_KEY=
