{
  "outputDirectory": "frontend",
  "crons": [
    {
      "path": "/api/indexer",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/cron/generate-markets",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/points-snapshot-prices",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/points-token-mcap-snapshots",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/generate-markets-pending",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/points-auto-resolve",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/points-parlay-settle",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/points-auto-feature",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/points-maker-rewards",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/points-tournament-snapshot",
      "schedule": "59 5 * * *"
    },
    {
      "path": "/api/cron/mananera-transcript",
      "schedule": "0 0,3,18,21 * * *"
    },
    {
      "path": "/api/cron/aicm-poll",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/aicm-timetable-poll",
      "schedule": "*/20 * * * *"
    }
  ],
  "redirects": [
    { "source": "/",          "destination": "/points/",          "permanent": false },
    { "source": "/privacy",   "destination": "/points/privacy",   "permanent": false },
    { "source": "/terms",     "destination": "/points/terms",     "permanent": false },
    { "source": "/portfolio",  "destination": "/points/portfolio",  "permanent": true },
    { "source": "/admin",      "destination": "/points/admin",      "permanent": true },
    { "source": "/points/deck","destination": "/deck",              "permanent": true },
    { "source": "/investors",  "destination": "/deck",              "permanent": true },
    { "source": "/earn",       "destination": "/points/earn",       "permanent": true },
    { "source": "/market",     "destination": "/points/market",     "permanent": true },
    { "source": "/u/:username","destination": "/points/u/:username","permanent": true },
    { "source": "/c/infraestructura/aicm", "destination": "/points/c/infraestructura/aicm", "permanent": true },
    { "source": "/c/deportes/uefa-champions-league", "destination": "/points/c/deportes/uefa-champions-league", "permanent": true },
    { "source": "/c/:slug",    "destination": "/points/c/:slug",    "permanent": true }
  ],
  "rewrites": [
    { "source": "/i",                  "destination": "/api/points/publicity/redirect?source=instagram" },
    { "source": "/i/",                 "destination": "/api/points/publicity/redirect?source=instagram" },
    { "source": "/t",                  "destination": "/api/points/publicity/redirect?source=tiktok" },
    { "source": "/t/",                 "destination": "/api/points/publicity/redirect?source=tiktok" },
    { "source": "/x",                  "destination": "/api/points/publicity/redirect?source=x" },
    { "source": "/x/",                 "destination": "/api/points/publicity/redirect?source=x" },
    { "source": "/instagram",          "destination": "/api/points/publicity/redirect?source=instagram" },
    { "source": "/instagram/",         "destination": "/api/points/publicity/redirect?source=instagram" },
    { "source": "/tiktok",             "destination": "/api/points/publicity/redirect?source=tiktok" },
    { "source": "/tiktok/",            "destination": "/api/points/publicity/redirect?source=tiktok" },
    { "source": "/twitter",            "destination": "/api/points/publicity/redirect?source=x" },
    { "source": "/twitter/",           "destination": "/api/points/publicity/redirect?source=x" },
    { "source": "/points/i",           "destination": "/api/points/publicity/redirect?source=instagram" },
    { "source": "/points/i/",          "destination": "/api/points/publicity/redirect?source=instagram" },
    { "source": "/points/t",           "destination": "/api/points/publicity/redirect?source=tiktok" },
    { "source": "/points/t/",          "destination": "/api/points/publicity/redirect?source=tiktok" },
    { "source": "/points/x",           "destination": "/api/points/publicity/redirect?source=x" },
    { "source": "/points/x/",          "destination": "/api/points/publicity/redirect?source=x" },
    { "source": "/points/instagram",   "destination": "/api/points/publicity/redirect?source=instagram" },
    { "source": "/points/instagram/",  "destination": "/api/points/publicity/redirect?source=instagram" },
    { "source": "/points/tiktok",      "destination": "/api/points/publicity/redirect?source=tiktok" },
    { "source": "/points/tiktok/",     "destination": "/api/points/publicity/redirect?source=tiktok" },
    { "source": "/points/twitter",     "destination": "/api/points/publicity/redirect?source=x" },
    { "source": "/points/twitter/",    "destination": "/api/points/publicity/redirect?source=x" },
    { "source": "/r/:username",        "destination": "/api/share/referral?username=:username" },
    { "source": "/que-es-el-libro-de-ordenes",  "destination": "/que-es-el-libro-de-ordenes.html" },
    { "source": "/que-es-el-libro-de-ordenes/", "destination": "/que-es-el-libro-de-ordenes.html" },
    { "source": "/mvp/market",    "destination": "/mvp/" },
    { "source": "/mvp/portfolio", "destination": "/mvp/" },
    { "source": "/mvp/admin",     "destination": "/mvp/" },
    { "source": "/mvp/c/deportes/uefa-champions-league", "destination": "/mvp/" },
    { "source": "/mvp/privacy",   "destination": "/mvp/" },
    { "source": "/mvp/terms",     "destination": "/mvp/" },
    { "source": "/points/market",       "destination": "/points/" },
    { "source": "/points/portfolio",    "destination": "/points/" },
    { "source": "/points/admin",        "destination": "/points/" },
    { "source": "/demo",                "destination": "/points/" },
    { "source": "/demo/:path*",         "destination": "/points/" },
    { "source": "/points-demo",         "destination": "/points/" },
    { "source": "/points-demo/:path*",  "destination": "/points/" },
    { "source": "/deck",                "destination": "/points/" },
    { "source": "/developer",           "destination": "/points/" },
    { "source": "/points/earn",         "destination": "/points/" },
    { "source": "/points/developer",    "destination": "/points/" },
    { "source": "/points/privacy",      "destination": "/points/" },
    { "source": "/points/terms",        "destination": "/points/" },
    { "source": "/points/r/:username",  "destination": "/points/" },
    { "source": "/points/u/:username",  "destination": "/points/" },
    { "source": "/points/c/infraestructura/aicm", "destination": "/points/" },
    { "source": "/points/c/deportes/uefa-champions-league", "destination": "/points/" },
    { "source": "/points/c/:slug",      "destination": "/points/" },
    { "source": "/points/:path*",       "destination": "/points/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://tally.so https://*.tally.so https://*.turnkey.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://api.turnkey.com https://*.turnkey.com https://pronos.io https://arb1.arbitrum.io https://sepolia-rollup.arbitrum.io https://*.infura.io https://*.alchemy.com https://*.ankr.com https://safe-transaction-arbitrum.safe.global https://safe-transaction-arbitrum-sepolia.safe.global https://*.sentry.io; frame-src 'self' https://tally.so https://*.tally.so https://*.turnkey.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self';"
        }
      ]
    },
    {
      "source": "/demo",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store, no-cache" }
      ]
    },
    {
      "source": "/points-demo",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store, no-cache" }
      ]
    },
    {
      "source": "/deck",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache" }
      ]
    }
  ]
}
